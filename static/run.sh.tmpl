#!/usr/bin/env bash
set -euo pipefail

GWAS_CE_BASE_URL="{{GWAS_CE_BASE_URL}}"
DOCKER_INSTALL_URL="https://docs.docker.com/get-docker/"

PREFLIGHT_ONLY=0
METADATA_ONLY=0
SETUP_ONLY=0
GWAS_ONLY=0
REFDATA_ONLY=0
CONFIG_ONLY=0
FALCON_ONLY=0
UPLOAD_ONLY=0
FINALIZE_ONLY=0
TOKEN=""
FALCON_HOME_DEFAULT="${HOME}/falcon"
FALCON_HOME="${FALCON_HOME:-$FALCON_HOME_DEFAULT}"
for arg in "$@"; do
  case "$arg" in
    --preflight-only) PREFLIGHT_ONLY=1 ;;
    --metadata-only) METADATA_ONLY=1 ;;
    --setup-only) SETUP_ONLY=1 ;;
    --gwas-only) GWAS_ONLY=1 ;;
    --refdata-only) REFDATA_ONLY=1 ;;
    --config-only) CONFIG_ONLY=1 ;;
    --falcon-only) FALCON_ONLY=1 ;;
    --upload-only) UPLOAD_ONLY=1 ;;
    --finalize-only) FINALIZE_ONLY=1 ;;
    --*) echo "unknown flag: $arg" >&2; exit 2 ;;
    *) TOKEN="$arg" ;;
  esac
done

require() {
  local bin="$1"; local hint="$2"
  if ! command -v "$bin" >/dev/null 2>&1; then
    echo "error: required tool '$bin' not on PATH. $hint" >&2
    exit 1
  fi
}

preflight() {
  require curl    "Install curl from your package manager."
  require tar     "Install tar from your package manager."
  require python3 "Install python3 (already standard on macOS and modern Linux)."

  if command -v sha256sum >/dev/null 2>&1; then
    SHA256_CMD="sha256sum"
  elif command -v shasum >/dev/null 2>&1; then
    SHA256_CMD="shasum -a 256"
  else
    echo "error: need sha256sum (Linux) or shasum (macOS)." >&2
    exit 1
  fi
  export SHA256_CMD

  if ! command -v docker >/dev/null 2>&1; then
    echo "error: docker not on PATH. Install Docker: ${DOCKER_INSTALL_URL}" >&2
    exit 1
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "error: docker is installed but the daemon isn't responding. Start Docker and re-run." >&2
    exit 1
  fi
}

preflight
[ "$PREFLIGHT_ONLY" -eq 1 ] && exit 0

require_token() {
  if [ -z "$TOKEN" ]; then
    echo "error: missing dataset token. Usage: bash run.sh <DATASET_TOKEN>" >&2
    exit 2
  fi
}

# curl_with_retry METHOD URL OUTFILE [extra curl args ...]
#
# 3 attempts with sleeps of 1s then 2s between them. Treats 5xx and curl
# transport errors as transient; treats any 4xx as terminal (caller
# inspects http_code). On final failure, prints a clear message and
# exits 1. Echoes the final HTTP status code to stdout for the caller.
curl_with_retry() {
  local method="$1" url="$2" outfile="$3"
  shift 3
  local attempt http_code sleep_for=1
  for attempt in 1 2 3; do
    http_code="$(curl -s -o "$outfile" -w "%{http_code}" -X "$method" "$@" "$url" || echo "000")"
    if [ "$http_code" = "000" ] || [[ "$http_code" =~ ^5 ]]; then
      if [ "$attempt" -lt 3 ]; then
        sleep "$sleep_for"
        sleep_for=$((sleep_for * 2))
        continue
      fi
      echo "error: Couldn't reach ${url%%/api/*} (HTTP ${http_code}) after 3 attempts. Check your connection and re-run the same command." >&2
      exit 1
    fi
    break
  done
  echo "$http_code"
}

fetch_metadata() {
  require_token
  local resp_file http_code
  resp_file="$(mktemp)"
  http_code="$(curl_with_retry GET "${GWAS_CE_BASE_URL}/api/falcon/dataset" "$resp_file" \
    -H "Authorization: Bearer ${TOKEN}")"
  if [ "$http_code" = "401" ] || [ "$http_code" = "410" ]; then
    echo "Your run link has expired. Go back to your dataset on ${GWAS_CE_BASE_URL} and click Run FALCON again to get a new link." >&2
    exit 1
  fi
  if [ "$http_code" != "200" ]; then
    echo "error: gwas-ce returned HTTP $http_code while fetching dataset metadata" >&2
    cat "$resp_file" >&2
    exit 1
  fi
  METADATA_JSON="$(cat "$resp_file")"
  rm -f "$resp_file"

  jget() {
    python3 -c "import json,sys; v=json.loads(sys.stdin.read()).get(sys.argv[1]); print('' if v is None else v)" "$1" <<<"$METADATA_JSON"
  }
  DATASET_NAME="$(jget dataset_name)"
  GWAS_FILENAME="$(jget gwas_filename)"
  EXPECTED_SHA="$(jget expected_gwas_sha256)"
  GWAS_DOWNLOAD_URL="$(jget gwas_download_url)"
  SAMPLE_SIZE="$(jget sample_size)"
  INF_HERIT="$(jget inf_heritability)"
  CHR_TO_UPDATE="$(jget chr_to_update)"
  # Optional override for a fast smoke test: e.g. FALCON_CHRS=22 limits both the
  # reference top-up and the FALCON run to one chromosome (~280 MB vs tens of GB).
  # The chosen chromosome(s) must be present in your GWAS.
  CHR_TO_UPDATE="${FALCON_CHRS:-$CHR_TO_UPDATE}"
  IMAGE="$(jget image)"
  # FALCON sumstats column config lines, resolved from the dataset's col_map
  # server-side and returned in sumstats_columns. Empty if the server didn't
  # send them (older API) -> FALCON falls back to its defaults.
  SUMSTATS_COL_LINES="$(python3 -c "import json,sys; d=json.loads(sys.stdin.read()).get('sumstats_columns',{}); print('\n'.join(f'{k} = {v}' for k,v in d.items()))" <<<"$METADATA_JSON")"
  WEB_APP_BASE_URL="$(jget web_app_base_url)"

  echo "dataset: ${DATASET_NAME}"
}

fetch_metadata
[ "$METADATA_ONLY" -eq 1 ] && exit 0

setup_dirs() {
  mkdir -p "${FALCON_HOME}/data" "${FALCON_HOME}/work"
  # Export so the upload_results Python helpers can read it via os.environ.
  export WORK_DIR="${FALCON_HOME}/work/${DATASET_NAME}"
  mkdir -p "$WORK_DIR"
}

ensure_image() {
  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "pulling docker image ${IMAGE} (one-time, ~1 GB)…"
    docker pull "$IMAGE"
  fi
}

prompt_tty() {
  # This script is delivered via `curl … | bash`, so fd 0 is the script text,
  # not the keyboard. Read interactive answers from the controlling terminal;
  # fall back to a default when none is attached (non-interactive / CI) so the
  # script never blocks or consumes its own source as input.
  # $1 = prompt text, $2 = default when non-interactive, $3 = (optional) name of
  # an env var that pre-answers the prompt (for tests / automation).
  # Order: env override → controlling terminal → default.
  local _reply
  if [ -n "${3:-}" ] && [ -n "${!3:-}" ]; then
    printf '%s' "${!3}"
    return
  fi
  if [ -r /dev/tty ]; then
    read -r -p "$1" _reply < /dev/tty || _reply="$2"
  else
    _reply="$2"
  fi
  printf '%s' "$_reply"
}

setup_dirs
ensure_image
[ "$SETUP_ONLY" -eq 1 ] && exit 0

resolve_gwas() {
  local dest="${WORK_DIR}/${GWAS_FILENAME}"
  if [ ! -f "$dest" ]; then
    if [ -n "${FALCON_GWAS_PATH:-}" ]; then
      # Local override: use a copy you already have instead of downloading.
      if [ ! -f "$FALCON_GWAS_PATH" ]; then
        echo "error: FALCON_GWAS_PATH '${FALCON_GWAS_PATH}' does not exist" >&2; exit 1
      fi
      ln -sf "$(realpath "$FALCON_GWAS_PATH")" "$dest"
    else
      # Default: download the GWAS you uploaded for this dataset. The presigned
      # URL carries its own auth, so no AWS credentials are needed here.
      if [ -z "${GWAS_DOWNLOAD_URL:-}" ]; then
        echo "error: gwas-ce did not provide a download URL for this dataset's GWAS." >&2
        echo "       Set FALCON_GWAS_PATH to a local copy and re-run." >&2
        exit 1
      fi
      echo "Downloading GWAS '${GWAS_FILENAME}' for ${DATASET_NAME}…"
      if ! curl -fSL -o "$dest" "$GWAS_DOWNLOAD_URL"; then
        rm -f "$dest"
        echo "error: failed to download the GWAS file from gwas-ce." >&2; exit 1
      fi
    fi
  fi
  local actual
  actual="$(${SHA256_CMD} "$dest" | awk '{print $1}')"
  if [ "$actual" != "$EXPECTED_SHA" ]; then
    # Remove the downloaded file / symlink so the next run re-fetches instead
    # of silently rehashing the same wrong bytes.
    rm -f "$dest"
    echo "error: GWAS file at ${dest}" >&2
    echo "       sha256 ${actual}" >&2
    echo "       doesn't match the one you uploaded (expected ${EXPECTED_SHA})." >&2
    echo "       If you re-derived the file, re-upload the GWAS on ${WEB_APP_BASE_URL}." >&2
    exit 1
  fi
  GWAS_PATH="$dest"
}

resolve_gwas
[ "$GWAS_ONLY" -eq 1 ] && exit 0

expand_chrs() {
  # "1-3,5,22" → "1 2 3 5 22"
  python3 -c '
import sys
spec = sys.argv[1]
out = []
for part in spec.split(","):
    part = part.strip()
    if "-" in part:
        a, b = part.split("-")
        out.extend(range(int(a), int(b) + 1))
    else:
        out.append(int(part))
print(" ".join(str(c) for c in out))
' "$1"
}

missing_chrs_for_topup() {
  local chrs="$1"; local missing=() expanded
  # Capture before the for-loop: bash's errexit doesn't propagate through
  # $(...) when it's used as a for-loop word list, so a failure in
  # expand_chrs would otherwise silently skip the top-up entirely.
  expanded="$(expand_chrs "$chrs")"
  for c in $expanded; do
    if [ ! -f "${FALCON_HOME}/data/LD/${c}.ld.sorted.gz" ] \
    || [ ! -f "${FALCON_HOME}/data/genes/${c}.genes.loc" ] \
    || [ ! -f "${FALCON_HOME}/data/V2G/cS2G.${c}.SGscore" ]; then
      missing+=("$c")
    fi
  done
  (IFS=,; echo "${missing[*]}")
}

topup_refdata() {
  local missing
  missing="$(missing_chrs_for_topup "$CHR_TO_UPDATE")"
  if [ -n "$missing" ]; then
    echo "fetching reference data for missing chromosomes: $missing"
    # Run as the host user so downloaded reference files aren't root-owned.
    docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
      -v "${FALCON_HOME}/data:/falcon-data" \
      "$IMAGE" fetch-reference /falcon-data --chrs "$missing"
  fi
}

confirm_chr_scope() {
  if [ -n "${FALCON_CHRS:-}" ]; then
    echo "Running chromosome(s): ${CHR_TO_UPDATE}."
    return 0
  fi
  echo
  echo "No FALCON_CHRS set — running ALL chromosomes (${CHR_TO_UPDATE})."
  echo "This can download ~40 GB of reference data. Re-run with e.g."
  echo "FALCON_CHRS=22 to limit, or FALCON_CHRS=1-22 to keep the whole genome."
  if [ -r /dev/tty ]; then
    read -r -p "Press Enter to continue, or Ctrl-C to abort: " _ < /dev/tty
  else
    echo "error: refusing to run all chromosomes non-interactively. Set FALCON_CHRS (e.g. =22, or =1-22 for the whole genome) and re-run." >&2
    exit 1
  fi
}

confirm_chr_scope
topup_refdata
[ "$REFDATA_ONLY" -eq 1 ] && exit 0

write_config() {
  cat > "${WORK_DIR}/config.ini" <<EOF
[Settings]
out-base-name      = /work/results/run1
ld-folder          = /falcon-data/LD/
gene-folder        = /falcon-data/genes/
s2g-folder         = /falcon-data/V2G/

sumstats-file      = /work/${GWAS_FILENAME}
dataset-name       = ${DATASET_NAME}
web-app-base-url   = ${WEB_APP_BASE_URL}

sample-size        = ${SAMPLE_SIZE}
inf-heritability   = ${INF_HERIT}
chr-to-update      = ${CHR_TO_UPDATE}

${SUMSTATS_COL_LINES}
ld-chrom1-col      = CHR_A
s2g-rsid-col       = SNP
s2g-score-col      = cS2G
EOF
}

write_config
[ "$CONFIG_ONLY" -eq 1 ] && exit 0

idempotency_check() {
  if [ -d "${WORK_DIR}/results" ] && [ -n "$(ls -A "${WORK_DIR}/results" 2>/dev/null)" ]; then
    echo
    echo "Run already complete for this dataset in ${WORK_DIR}."
    choice="$(prompt_tty "[r]e-run / [u]pload only / [q]uit (default q): " "q" FALCON_IDEMPOTENCY)"
    case "${choice:-q}" in
      r|R) rm -rf "${WORK_DIR}/results" ;;
      u|U) SKIP_FALCON=1 ;;
      *)   exit 0 ;;
    esac
  fi
}

run_falcon() {
  [ "${SKIP_FALCON:-0}" = "1" ] && return 0
  # Run as the host user (not root) so result files written into the mounted
  # work dir are owned by the user and can be cleaned up / re-run without sudo.
  # HOME=/tmp gives matplotlib/fontconfig a writable cache dir under --user.
  docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "${FALCON_HOME}/data:/falcon-data:ro" \
    -v "${FALCON_HOME}/work/${DATASET_NAME}:/work" \
    "$IMAGE" run /work/config.ini
}

idempotency_check
run_falcon
[ "$FALCON_ONLY" -eq 1 ] && exit 0

upload_results() {
  # FALCON writes the run manifest into results/ as <base>.wg.manifest.json,
  # but the server's finalize reads it as manifest.json -- and the upload name
  # maps 1:1 to the S3 key. Stage a copy at the work root under that canonical
  # name so the listing below uploads it as manifest.json.
  local _mf
  for _mf in "${WORK_DIR}/results/"*.manifest.json; do
    [ -f "$_mf" ] && cp "$_mf" "${WORK_DIR}/manifest.json" && break
  done
  local files_json
  files_json="$(python3 - <<PY
import json, os
work = os.environ["WORK_DIR"]
out = []
results = os.path.join(work, "results")
if os.path.isdir(results):
    for f in os.listdir(results):
        full = os.path.join(results, f)
        if os.path.isfile(full):
            out.append({"name": f, "size": os.path.getsize(full)})
manifest = os.path.join(work, "manifest.json")
if os.path.exists(manifest):
    out.append({"name": "manifest.json", "size": os.path.getsize(manifest)})
print(json.dumps({"files": out}))
PY
)"

  local resp http_code
  resp="$(mktemp)"
  http_code="$(curl_with_retry POST "${GWAS_CE_BASE_URL}/api/falcon/${DATASET_NAME}/upload-urls" "$resp" \
    -H "Authorization: Bearer ${TOKEN}" \
    -H "Content-Type: application/json" \
    --data "$files_json")"
  if [ "$http_code" != "200" ]; then
    echo "error: upload-urls returned HTTP $http_code" >&2; cat "$resp" >&2; exit 1
  fi

  local retry="${WORK_DIR}/upload-retry.sh"
  rm -f "$retry"
  printf "#!/usr/bin/env bash\nset -e\n" > "$retry"

  python3 -c '
import json, os, sys
data = json.load(open(sys.argv[1]))
work = os.environ["WORK_DIR"]
for u in data["uploads"]:
    name = u["name"]
    path = os.path.join(work, name)
    if not os.path.exists(path):
        path = os.path.join(work, "results", name)
    print(u["url"] + "\t" + path)
' "$resp" | while IFS=$'\t' read -r url path; do
    if ! curl -sf -X PUT --upload-file "$path" "$url"; then
      echo "curl -X PUT --upload-file '${path}' '${url}'" >> "$retry"
    fi
  done

  if [ -s "$retry" ] && grep -q "PUT" "$retry"; then
    chmod +x "$retry"
    rm -f "$resp"
    echo "error: one or more uploads failed. To retry, run:" >&2
    echo "  bash ${retry}" >&2
    exit 1
  else
    rm -f "$retry"
  fi
  rm -f "$resp"
}

upload_results
[ "$UPLOAD_ONLY" -eq 1 ] && exit 0

finalize() {
  local resp http_code
  resp="$(mktemp)"
  http_code="$(curl_with_retry POST "${GWAS_CE_BASE_URL}/api/falcon/${DATASET_NAME}/finalize" "$resp" \
    -H "Authorization: Bearer ${TOKEN}")"
  case "$http_code" in
    2*) ;;
    *)  echo "error: finalize returned HTTP $http_code" >&2; cat "$resp" >&2; rm -f "$resp"; exit 1 ;;
  esac
  rm -f "$resp"
  echo
  echo "Results uploaded for dataset '${DATASET_NAME}'."
  echo "View on the web app: ${WEB_APP_BASE_URL}/datasets"
}

finalize
[ "$FINALIZE_ONLY" -eq 1 ] && exit 0
exit 0
